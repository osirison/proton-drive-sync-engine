Maintainer: osirison <mina.swe@gmail.com>
# libgtk-layer-shell-dev is #351/#370: the tray panel becomes a layer surface where the
# compositor supports one (KDE Plasma on Wayland, wlroots) and stays an ordinary toplevel
# elsewhere (X11, GNOME), because skip_taskbar and set_position are X11 hints a Wayland
# compositor discards. Build-time only - the runtime library lands in ${shlibs:Depends}
# via dh_shlibdeps, like the rest.
#
# cargo and rustc need 1.90: the locked tauri-runtime, tauri-utils, tauri-runtime-wry,
# tauri-plugin-fs and tray-icon crates declare rust-version 1.90. The release build installs Rust
# with rustup, because the oldest release it is built on (Ubuntu 22.04) packages an older one, and
# builds with --build-profiles=pkg.proton-drive-sync-engine.rustup, which drops the two entries
# marked <!pkg.proton-drive-sync-engine.rustup> from the check and keeps every other entry. A build
# without that profile still needs the distribution's own cargo and rustc at 1.90 or newer.
Build-Depends: debhelper-compat (= 13),
               dh-sequence-python3,
               cargo (>= 1.90~) <!pkg.proton-drive-sync-engine.rustup>,
               rustc (>= 1.90~) <!pkg.proton-drive-sync-engine.rustup>,
               pkg-config,
               libwebkit2gtk-4.1-dev,
               libsoup-3.0-dev,
               libgtk-3-dev,
               libglib2.0-dev,
               libgtk-layer-shell-dev
Standards-Version: 4.6.2
