post_install() {
  # Said once, at install: an upgrade means the CLI is already set up, and pacman would repeat
  # this note on every upgrade.
  echo "==> Proton's proton-drive command-line client must be installed and signed in before"
  echo "    you use Proton Drive Sync. Download it from https://proton.me/drive/download,"
  echo "    then run: proton-drive auth login"
  post_upgrade
}

post_upgrade() {
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor &>/dev/null || true

  if command -v update-desktop-database &>/dev/null; then
    update-desktop-database -q /usr/share/applications || true
  fi

  if command -v appstreamcli &>/dev/null; then
    appstreamcli refresh --force &>/dev/null || true
  fi
}

post_remove() {
  post_upgrade
}
