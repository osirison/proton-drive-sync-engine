# Binary assets. Without this, `git diff` on a re-vendored typeface tries to render ~17 KB of
# compressed font as text, and a merge would attempt a line-based union on it.
*.woff2 binary
*.woff binary
*.png binary
*.ico binary

# The fidelity fixtures are generated by gui/tools/fidelity/extract.mjs, never hand-edited. Marking
# them keeps them out of the diff view by default and stops 57k lines of ground truth drowning a
# 500-line code change — Copilot refused to review PR #201 at all for exactly that reason. They stay
# checked in on purpose: a prototype edit that moves a number must show up as a reviewable diff, and
# `git diff tools/fidelity/frames` still produces one on demand.
gui/tools/fidelity/frames/** linguist-generated=true
